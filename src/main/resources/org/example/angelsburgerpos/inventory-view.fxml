<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="700.0" spacing="15.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.angelsburgerpos.controller.InventoryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="INGREDIENT INVENTORY">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
                <TableColumn fx:id="colName" prefWidth="250.0" text="Ingredient Name" />
                <TableColumn fx:id="colStock" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Stock" />
                <TableColumn fx:id="colUnit" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Unit" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #eee; -fx-padding: 10; -fx-border-color: #ccc;">
            <children>
                <Label style="-fx-font-weight: bold;" text="Restock Selected:" />
                <TextField fx:id="restockInput" prefWidth="80.0" promptText="Qty" />
                <Button fx:id="restockBtn" mnemonicParsing="false" onAction="#addStock" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="ADD STOCK">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#closeWindow" text="CLOSE" />
            </children>
        </HBox>
    </children>
</VBox>
