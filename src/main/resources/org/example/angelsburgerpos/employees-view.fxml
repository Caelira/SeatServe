<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="700.0" spacing="15.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.angelsburgerpos.controller.EmployeesController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="EMPLOYEES">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colUsername" prefWidth="150.0" text="Username" />
                <TableColumn fx:id="colFullname" prefWidth="250.0" text="Full Name" />
                <TableColumn fx:id="colRole" prefWidth="150.0" text="Role" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <VBox spacing="10.0" style="-fx-background-color: #eee; -fx-padding: 15; -fx-border-color: #ccc;">
            <children>
                <Label style="-fx-font-weight: bold;" text="Register New Employee:" />
                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="usernameInput" promptText="Username" />
                        <TextField fx:id="passwordInput" promptText="Password" />
                        <TextField fx:id="fullnameInput" promptText="Full Name" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="roleInput" prefWidth="120.0" promptText="Role" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#removeUser" style="-fx-background-color: #d32f2f; -fx-text-fill: white;" text="REMOVE SELECTED" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#addUser" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="ADD USER">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#closeWindow" text="CLOSE" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
