<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1020.0" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.angelsburgerpos.controller.DashboardController">
   <top>
      <AnchorPane prefHeight="42.0" prefWidth="600.0" styleClass="top-bar" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="nameLabel" layoutX="14.0" layoutY="13.0" text="Manager Name" />
            <Label fx:id="dateLabel" layoutX="856.0" layoutY="13.0" text="Date &amp; Time" />
            <Label fx:id="roleLabel" layoutX="196.0" layoutY="13.0" text="Role" textFill="#777" />
            <Label layoutX="395.0" layoutY="7.0" styleClass="header-label" text="ANGELS BURGER">
               <font>
                  <Font size="22.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
   </top>
   <left>
      <AnchorPane prefHeight="358.0" prefWidth="173.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="logoutButton" layoutX="29.0" layoutY="679.0" mnemonicParsing="false" onAction="#logoutClicked" prefHeight="29.0" prefWidth="114.0" style="-fx-background-color: #444;" text="Logout" textFill="WHITE" />

            <Button fx:id="inventoryButton" layoutX="29.0" layoutY="386.0" mnemonicParsing="false" onAction="#inventoryClicked" prefHeight="29.0" prefWidth="114.0" text="Inventory" />
            <Button fx:id="reportsButton" layoutX="29.0" layoutY="336.0" mnemonicParsing="false" onAction="#reportsClicked" prefHeight="29.0" prefWidth="114.0" text="Reports" />
            <Button fx:id="employeesButton" layoutX="29.0" layoutY="440.0" mnemonicParsing="false" onAction="#employeesClicked" prefHeight="29.0" prefWidth="114.0" text="Employees" />
            <Button fx:id="menuButton" layoutX="29.0" layoutY="288.0" mnemonicParsing="false" onAction="#menuButtonClicked" prefHeight="29.0" prefWidth="114.0" text="Manual Order" />
            <ImageView fx:id="logo" fitHeight="150.0" fitWidth="150.0" layoutX="12.0" layoutY="61.0" pickOnBounds="true" preserveRatio="false" />
            <Button fx:id="mobileOrdersButton" layoutX="30.0" layoutY="245.0" mnemonicParsing="false" onAction="#viewMobileOrdersClicked" prefHeight="29.0" prefWidth="114.0" text="Mobile Orders" />
            <Button fx:id="warningButtonForAdmin" layoutX="26.0" layoutY="561.0" onAction="#showLowStockView" prefHeight="40.0" prefWidth="120.0" text="LOW ON STOCK" />
            <Button fx:id="warningButton" layoutX="27.0" layoutY="481.0" onAction="#showLowStockView" prefHeight="40.0" prefWidth="120.0" text="LOW ON STOCK" />
            <Button fx:id="archiveButton" layoutX="27.0" layoutY="521.0" onAction="#archivesClicked" prefHeight="40.0" prefWidth="120.0" text="Archives" />
         </children>
      </AnchorPane>
   </left>
   <center>
      <StackPane fx:id="mainContentArea" prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <AnchorPane fx:id="menuSection" prefHeight="200.0" prefWidth="200.0">
               <children>
                  <VBox layoutX="332.0" layoutY="217.0" prefHeight="757.6" prefWidth="1026.4" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <AnchorPane prefHeight="80.0" prefWidth="1026.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" layoutX="33.0" layoutY="20.0" spacing="20.0">
                                 <children>
                                    <Button onAction="#filterAll" prefHeight="40.0" prefWidth="80.0" text="ALL" />
                                    <Button fx:id="burgersButton" onAction="#filterBurgers" prefHeight="40.0" prefWidth="120.0" text="Burgers" />
                                    <Button fx:id="sandwichesButton" onAction="#filterSandwiches" prefHeight="40.0" prefWidth="120.0" text="Sandwiches" />
                                    <Button fx:id="drinksButton" onAction="#filterDrinks" prefHeight="40.0" prefWidth="120.0" text="Drinks" />
                                 </children>
                              </HBox>
                           </children>
                        </AnchorPane>

                        <TableView fx:id="menuTable" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colName" prefWidth="250.0" text="Product Name" />
                              <TableColumn fx:id="colCategory" prefWidth="150.0" text="Category" />
                              <TableColumn fx:id="colPrice" prefWidth="100.0" style="-fx-alignment: CENTER-RIGHT;" text="Price" />
                              <TableColumn fx:id="colStock" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Stock" />
                              <TableColumn fx:id="colAction" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Action" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <VBox.margin>
                              <Insets left="20.0" right="20.0" />
                           </VBox.margin>
                        </TableView>

                        <AnchorPane prefHeight="100.0" prefWidth="1026.0" style="-fx-background-color: #f4f4f4; -fx-border-color: #ddd; -fx-border-width: 1 0 0 0;">
                           <children>
                              <Label layoutX="35.0" layoutY="35.0" text="Total Amount:">
                                 <font>
                                    <Font size="18.0" />
                                 </font>
                              </Label>
                              <Label fx:id="totalLabel" layoutX="165.0" layoutY="30.0" styleClass="total-label" text="P 0.00">
                                 <font>
                                    <Font name="System Bold" size="24.0" />
                                 </font>
                              </Label>

                              <Button fx:id="viewCartButton" layoutX="620.0" layoutY="24.0" mnemonicParsing="false" onAction="#viewCartClicked" prefHeight="50.0" prefWidth="180.0" styleClass="action-button" text="VIEW CART (0)">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Button>
                           </children>
                        </AnchorPane>
                     </children>
                  </VBox>
               </children>
            </AnchorPane>
         </children>
      </StackPane>
   </center>
</BorderPane>
