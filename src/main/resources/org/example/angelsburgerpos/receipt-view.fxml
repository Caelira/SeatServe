<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="350.0" spacing="10.0" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.angelsburgerpos.controller.ReceiptController">
    <children>
        <Label text="TRANSACTION COMPLETE" textFill="#2e7d32">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </Label>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: white;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
            <content>
                <VBox alignment="TOP_CENTER" style="-fx-background-color: white;">
                    <children>
                        <Label fx:id="receiptLabel" alignment="TOP_LEFT" text="Receipt Text Here..." wrapText="true">
                            <font>
                                <Font name="Monospaced Regular" size="13.0" />
                            </font>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </Label>
                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <Button mnemonicParsing="false" onAction="#closeWindow" prefWidth="200.0" style="-fx-background-color: #333; -fx-text-fill: white; -fx-cursor: hand;" text="DONE (CLOSE)">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
            <VBox.margin>
                <Insets bottom="15.0" />
            </VBox.margin>
        </Button>
    </children>
</VBox>