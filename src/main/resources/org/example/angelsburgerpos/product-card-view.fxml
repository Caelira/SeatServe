<AnchorPane fx:id="productCard" prefHeight="300.0" prefWidth="250.0" stylesheets="@css/card-design.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.angelsburgerpos.controller.ProductCardController">
   <children>
      <AnchorPane fx:id="imageCard" layoutX="152.0" layoutY="38.0" prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
