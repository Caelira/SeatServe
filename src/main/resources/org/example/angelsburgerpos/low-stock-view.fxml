<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="400.0" spacing="10.0"
      style="-fx-background-color: #ffebee; -fx-border-color: #d32f2f; -fx-border-width: 2;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.angelsburgerpos.controller.LowStockController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="⚠ LOW STOCK WARNING" textFill="#d32f2f">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <Label text="The following items are running out:" />

    <TableView fx:id="lowStockTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" prefWidth="200.0" text="Ingredient" />
            <TableColumn fx:id="colStock" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Stock" />
            <TableColumn fx:id="colUnit" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Unit" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <Button onAction="#closeWindow" text="CLOSE" style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold;"/>
</VBox>