<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="650.0" spacing="10.0" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 2;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.angelsburgerpos.controller.CartController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="EDIT ORDER">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>
        <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName" prefWidth="250.0" text="Product Name" />
                <TableColumn fx:id="colQty" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Qty" />
                <TableColumn fx:id="colPrice" prefWidth="100.0" style="-fx-alignment: CENTER-RIGHT;" text="Price" />
                <TableColumn fx:id="colTotal" prefWidth="100.0" style="-fx-alignment: CENTER-RIGHT;" text="Total" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label style="-fx-font-weight: bold;" text="Edit Qty:" />
                <Button mnemonicParsing="false" onAction="#subtractQty" prefWidth="40.0" style="-fx-background-color: #ddd; -fx-border-color: #999;" text="-">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#addQty" prefWidth="40.0" style="-fx-background-color: #ddd; -fx-border-color: #999;" text="+">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#removeSelected" style="-fx-background-color: #d32f2f; -fx-text-fill: white;" text="REMOVE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#onPayClicked" style="-fx-background-color: #2e7d32; -fx-text-fill: white;" text="PAY NOW">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#closeWindow" style="-fx-background-color: #555; -fx-text-fill: white;" text="CLOSE">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>